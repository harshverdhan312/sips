# ==============================================================================
# SIPS - Skill Intelligence Placement System Backend Environment Template
# Duplicate this file as '.env' and populate with your environment values
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Connection URI
# ------------------------------------------------------------------------------
# Option A - Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/sips

# Option B - MongoDB Atlas (Cloud Database):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/sips?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Security & JWT Token
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ------------------------------------------------------------------------------
# Frontend Client URL (for CORS)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
