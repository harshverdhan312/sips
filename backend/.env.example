# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/sips

# Authentication
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Machine Learning Service
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=5000
ML_SERVICE_API_KEY=

# Cloudinary (Persistent Image CDN for Profile Pictures & College Logos)
# Option 1: Full URL format
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Option 2: Individual variables (alternative to CLOUDINARY_URL)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
