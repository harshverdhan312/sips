NODE_ENV=development
PORT=5050
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sips_practice?schema=public
JWT_SECRET=replace-with-the-same-sips-jwt-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Judge0 Execution Configuration
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=
EXECUTION_POLL_INTERVAL_MS=500
EXECUTION_POLL_MAX_RETRIES=20

# SIPS Core Integration (Server-to-server eligibility handshake)
SIPS_CORE_BASE_URL=http://localhost:5000
SIPS_INTERNAL_API_SECRET=replace-with-local-secret
SIPS_ELIGIBILITY_TIMEOUT_MS=5000
